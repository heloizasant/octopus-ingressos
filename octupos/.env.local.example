# Copie este arquivo para `.env.local` e preencha os valores.
# O `.env.local` é ignorado pelo Git e nunca deve ser enviado ou compartilhado.

# Públicas: podem aparecer no navegador.
# Supabase → Project Settings → API Keys (e Data API para a URL).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SECRETA: acesso total ao banco. Usada só pelo script de seed (npm run seed),
# nunca pelo site. Não use o prefixo NEXT_PUBLIC_ nesta variável.
SUPABASE_SECRET_KEY=

# SECRETA: senha das contas de demonstração criadas pelo seed (mín. 12 caracteres).
SEED_DEMO_PASSWORD=
